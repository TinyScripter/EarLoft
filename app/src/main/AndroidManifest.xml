<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Playback notification (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Servers on the home network (e.g. http://192.168.x.x): from Android 17 on reachable only with this permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Widget: find the launcher app so it may load the cover (package visibility from API 30). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Audiobookshelf sign-in via OpenID: find browsers with Custom Tabs or Auth Tab (concept 12.11). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Now playing → Equalizer: only offer it if the system or an app provides one. -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <!-- MissingMediaBrowserServiceIntentFilter: The PlaybackService and its filter are in the manifest of core:playback,
         which lint doesn't read here.
         largeHeap: For MP4/M4B, ExoPlayer keeps the sample table of the whole file on the Java heap (about 32 bytes per
         AAC frame, roughly 85 MB for a 17-hour book, briefly double that while parsing). With the normal limit (192 MB on the
         emulator) long audiobooks failed with OutOfMemoryError. -->
    <application
        android:name=".EarLoftApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EarLoft">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EarLoft"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Voice search ("Play … with EarLoft"); Android Auto goes through the session. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            "Play" from the new-episode notification: only via this non-exported route, otherwise any app could
            start playback of an arbitrary episode (review D30).
        -->
        <activity-alias
            android:name=".NotificationPlay"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!--
            Shared podcast addresses (concept 13) open the preview; EarLoft excludes itself from its own share menu.
            Goes through this trampoline, otherwise sharing would open a second MainActivity in its own task.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="feed" />
                <data android:scheme="pcast" />
                <data android:scheme="itpc" />
                <data android:scheme="podcast" />
            </intent-filter>
        </activity>

        <!--
            Redirect back from the OpenID sign-in for browsers without Auth Tab (concept 12.11). Deliberately not
            `audiobookshelf://`: that belongs to the official app, and with Auth Tab no filter is needed.
        -->
        <activity
            android:name=".OpenIdRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="earloft" />
            </intent-filter>
        </activity>

        <!-- Android Auto: media app; browse tree and playback come from the PlaybackService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Chromecast with the Default Media Receiver; initialized in EarLoftApplication. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />

        <!-- System output switcher (playback notification, lock screen): without this receiver it only shows
             phone and Bluetooth, no cast devices, and can't switch between phone and receiver. -->
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" />

        <!-- Actions of the new-episode notification ("Play next", "Download"). -->
        <receiver
            android:name=".notification.NewEpisodeActionReceiver"
            android:exported="false" />

        <!-- Widget configuration when it is added and via "Customize widget" (note 8.14). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.EarLoft">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Share downloaded episodes as files; access only via the share intent's one-time grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_file_paths" />
        </provider>

        <!-- Messages from the watch (Wear concept 4); Play services start the service on demand. -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- Packets from the watch (/earloft/plays/<uuid>, /earloft/episodes/<uuid>), even when the app isn't running. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/plays/"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/episodes/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The watch waits for the phone (review V1); delivered as soon as both are connected again. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/earloft/phone-wanted"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Transfer to the watch as a foreground worker (WatchFileTransfers). core:download declares the same, but lint
             only reads this manifest; replace prevents a merged "dataSync|dataSync". -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>

</manifest>