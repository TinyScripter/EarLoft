<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wiedergabe-Benachrichtigung (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Server im Heimnetz (z. B. http://192.168.x.x): ab Android 17 nur mit dieser Berechtigung erreichbar. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Widget: Die Startbildschirm-App finden, damit sie das Cover laden darf (Paket-Sichtbarkeit ab API 30). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Anmeldung bei Audiobookshelf per OpenID: Browser mit Custom Tabs bzw. Auth Tab finden (Konzept 12.11). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Now Playing → Equalizer: nur anbieten, wenn das System oder eine App einen hat. -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <!-- MissingMediaBrowserServiceIntentFilter: Der PlaybackService samt Filter steht im Manifest von core:playback, das
         Lint hier nicht mitliest.
         largeHeap: ExoPlayer hält bei MP4/M4B die Sample-Tabelle der ganzen Datei im Java-Heap (rund 32 Byte je
         AAC-Frame, ein 17-h-Buch etwa 85 MB, beim Einlesen kurz das Doppelte). Mit der normalen Grenze (192 MB am
         Emulator) scheiterten lange Hörbücher mit OutOfMemoryError. -->
    <application
        android:name=".EarLoftApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EarLoft">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EarLoft"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sprachsuche („Spiele … mit EarLoft“); Android Auto geht über die Session. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            „Abspielen“ aus der Benachrichtigung über eine neue Folge: nur über diesen nicht exportierten Weg, sonst könnte jede App
            die Wiedergabe einer beliebigen Folge starten (Review D30).
        -->
        <activity-alias
            android:name=".NotificationPlay"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!--
            Geteilte Podcast-Adressen (Konzept 13) öffnen die Vorschau; EarLoft nimmt sich aus dem eigenen Teilen-Menü aus.
            Über diese Weiterleitung, sonst öffnete das Teilen eine zweite MainActivity in einer eigenen Aufgabe.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="feed" />
                <data android:scheme="pcast" />
                <data android:scheme="itpc" />
                <data android:scheme="podcast" />
            </intent-filter>
        </activity>

        <!--
            Rückleitung der Anmeldung per OpenID für Browser ohne Auth Tab (Konzept 12.11). Bewusst nicht
            `audiobookshelf://`: Das gehört der offiziellen App, mit Auth Tab braucht es keinen Filter.
        -->
        <activity
            android:name=".OpenIdRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="earloft" />
            </intent-filter>
        </activity>

        <!-- Android Auto: Medien-App; Browse-Tree und Wiedergabe kommen vom PlaybackService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Chromecast mit dem Default Media Receiver; initialisiert in EarLoftApplication. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />

        <!-- Ausgabeauswahl des Systems (Wiedergabe-Benachrichtigung, Sperrbildschirm): Ohne diesen Receiver zeigt sie nur
             Handy und Bluetooth, keine Cast-Geräte, und kann nicht zwischen Handy und Empfänger wechseln. -->
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" />

        <!-- Aktionen der Benachrichtigung über eine neue Folge („Als Nächstes“, „Laden“). -->
        <receiver
            android:name=".notification.NewEpisodeActionReceiver"
            android:exported="false" />

        <!-- Einstellungen eines Widgets beim Anlegen und über „Widget anpassen“ (Notiz 8.14). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.EarLoft">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Geladene Folgen als Datei teilen; Zugriff nur per Einmal-Berechtigung des Teilen-Intents. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_file_paths" />
        </provider>

        <!-- Nachrichten der Uhr (Wear-Konzept 4); die Play-Dienste starten den Dienst bei Bedarf. -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- Pakete der Uhr (/earloft/plays/<uuid>, /earloft/episodes/<uuid>), auch wenn die App nicht läuft. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/plays/"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/earloft/episodes/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- Die Uhr wartet aufs Handy (Review V1); zugestellt, sobald beide wieder verbunden sind. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/earloft/phone-wanted"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Übertragung zur Uhr als Vordergrund-Worker (WatchFileTransfers). core:download deklariert dasselbe, Lint
             liest aber nur dieses Manifest; replace verhindert ein zusammengefügtes "dataSync|dataSync". -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>

</manifest>