<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wiedergabe-Benachrichtigung (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Server im Heimnetz (z. B. http://192.168.x.x): ab Android 17 nur mit dieser Berechtigung erreichbar. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Widget: Die Startbildschirm-App finden, damit sie das Cover laden darf (Paket-Sichtbarkeit ab API 30). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- MissingMediaBrowserServiceIntentFilter: Der PlaybackService samt Filter steht im Manifest von core:playback, das
         Lint hier nicht mitliest. -->
    <application
        android:name=".TinyAmpApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TinyAmp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TinyAmp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sprachsuche („Spiele … mit TinyAmp“); Android Auto geht über die Session. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Geteilte Podcast-Adressen (Konzept 13) öffnen die Vorschau; TinyAmp nimmt sich aus dem eigenen Teilen-Menü aus. -->
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/podcast_add">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="feed" />
                <data android:scheme="pcast" />
                <data android:scheme="itpc" />
                <data android:scheme="podcast" />
            </intent-filter>
        </activity>

        <!-- Android Auto: Medien-App; Browse-Tree und Wiedergabe kommen vom PlaybackService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Chromecast mit dem Default Media Receiver; initialisiert in TinyAmpApplication. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />

        <!-- Ausgabeauswahl des Systems (Wiedergabe-Benachrichtigung, Sperrbildschirm): Ohne diesen Receiver zeigt sie nur
             Handy und Bluetooth, keine Cast-Geräte, und kann nicht zwischen Handy und Empfänger wechseln. -->
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" />

        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Nachrichten der Uhr (Wear-Konzept 4); die Play-Dienste starten den Dienst bei Bedarf. -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/tinyamp/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- Pakete der Uhr (/tinyamp/plays/<uuid>, /tinyamp/episodes/<uuid>), auch wenn die App nicht läuft. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/tinyamp/plays/"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/tinyamp/episodes/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Übertragung zur Uhr als Vordergrund-Worker (WatchFileTransfers). core:download deklariert dasselbe, Lint
             liest aber nur dieses Manifest; replace verhindert ein zusammengefügtes "dataSync|dataSync". -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />
    </application>

</manifest>