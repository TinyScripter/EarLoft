<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau in der Widget-Auswahl (4×1); bildet NowPlayingWidget nach: Cover links, Text und Steuerung zentriert.
     UseAppTint: Der Launcher bläht das Layout als RemoteViews ohne AppCompat auf, dort wirkt nur android:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/now_playing_widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/now_playing_widget_preview_cover"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_music_note"
        android:tint="#E6E0E9" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="#E6E0E9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_description"
            android:textColor="#CAC4D0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="#E6E0E9" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/now_playing_widget_preview_play"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                android:tint="#381E72" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#E6E0E9" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
