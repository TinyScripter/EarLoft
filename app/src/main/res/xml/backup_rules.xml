<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup bis API 30. Nicht gesichert werden (Konzept 10, Sicherheit):
    - die Hauptdatenbank – sie wird aus den Quellen neu aufgebaut; was keine Quelle kennt (Server, Abos, Statistik, Fortschritt, Musik-Nutzerdaten),
      steht zusätzlich in user.db und wird gesichert (Review K9);
    - die Datenbank von ExoPlayer – ein Zwischenspeicher dieses Geräts;
    - die verschlüsselten Zugangsdaten – der Schlüssel liegt im Keystore dieses Geräts;
    - der Stand des MediaStore beim letzten lokalen Scan – er gehört zur Datenbank;
    - der letzte Stand des Widgets – er nennt IDs der Hauptdatenbank.
    Downloads liegen in noBackupFilesDir und sind dadurch ohnehin ausgenommen.
    „Weiterhören“ und der Wiedergabestand speichern Schlüssel statt IDs der Hauptdatenbank und werden gesichert.
-->
<full-backup-content>
    <exclude domain="database" path="earloft.db" />
    <exclude domain="database" path="earloft.db-wal" />
    <exclude domain="database" path="earloft.db-shm" />
    <exclude domain="database" path="earloft.db-journal" />
    <exclude domain="database" path="exoplayer_internal.db" />
    <exclude domain="database" path="exoplayer_internal.db-journal" />
    <exclude domain="file" path="datastore/secrets.preferences_pb" />
    <exclude domain="file" path="datastore/local_scan.preferences_pb" />
    <exclude domain="file" path="datastore/widget_state.preferences_pb" />
</full-backup-content>
