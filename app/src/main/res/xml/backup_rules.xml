<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup up to API 30. Not backed up (concept 10, security):
    - the main database – it is rebuilt from the sources; whatever no source knows (servers, subscriptions, statistics,
      progress, music user data) is also kept in user.db, which is backed up (review K9);
    - ExoPlayer's database – a cache of this device;
    - the encrypted credentials – the key lives in this device's keystore;
    - the MediaStore state of the last local scan – it belongs to the database;
    - the last widget state – it names IDs of the main database.
    Downloads live in noBackupFilesDir and are excluded anyway.
    "Continue listening" and the playback state store keys instead of main database IDs and are backed up.
-->
<full-backup-content>
    <exclude domain="database" path="earloft.db" />
    <exclude domain="database" path="earloft.db-wal" />
    <exclude domain="database" path="earloft.db-shm" />
    <exclude domain="database" path="earloft.db-journal" />
    <exclude domain="database" path="exoplayer_internal.db" />
    <exclude domain="database" path="exoplayer_internal.db-journal" />
    <exclude domain="file" path="datastore/secrets.preferences_pb" />
    <exclude domain="file" path="datastore/local_scan.preferences_pb" />
    <exclude domain="file" path="datastore/widget_state.preferences_pb" />
</full-backup-content>
