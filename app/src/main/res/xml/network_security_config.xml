<?xml version="1.0" encoding="utf-8"?>
<!--
    Home servers often run over HTTP or with a self-signed certificate (concept 10, security):
    HTTP is allowed, but the server dialog only saves it after explicit confirmation;
    custom certificates work through CAs installed by the user.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
