<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lint checks this overlay on its own: the media service with its intent filter is in the main manifest. -->
    <application tools:ignore="MissingMediaBrowserServiceIntentFilter">
        <!-- Test hook (review H3): only the shell may send it. -->
        <receiver
            android:name="de.kleinabersmart.earloft.debug.ExpireAbsTokenReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.kleinabersmart.earloft.debug.EXPIRE_ABS_TOKEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
