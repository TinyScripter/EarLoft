<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Explicitly request Wi-Fi for downloads (Wear concept 8.2); foreground permissions come from :core:download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- From Android 17 (targetSdk 37) on, the app reaches devices on the home network, e.g. Navidrome, only with this runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Without it the download notification stays invisible, and with it the icon of running downloads on the
         watch face (Ongoing Activity, WO-V4). Playback does not need it, media notifications are exempt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Come from :core:datasource; the watch does not scan any music of its own (Wear concept 7.3). -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- largeHeap: The watch plays long M4B files with the same ExoPlayer as the phone; it keeps the sample table of the whole file
         in the Java heap (a 17 h book about 85 MB, briefly double that while parsing); the normal limit is 192 MB even on
         the watch emulator (512 MB with largeHeap).
         Backup: nothing of the watch is backed up or transferred (data_extraction_rules.xml). Up to Android 11
         allowBackup="false" already covers device transfer, so there is no fullBackupContent. -->
    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Not standalone: server, credentials and selection only come from the phone app (there is no login on the
             watch, WO-P6). After that the watch plays and downloads without the phone too. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The worker starts a dataSync foreground service; :core:download declares it too, but Lint only checks this manifest. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Changes and messages from the phone (Wear concept 4); Play services start the service when needed. Only the
             paths the service handles: remote control, covers and phone info are read only by the open app, and every
             item would otherwise start the process (including sync, planner and status to the phone). -->
        <service
            android:name=".sync.WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/earloft/servers" />
                <data android:path="/earloft/manifest" />
                <data android:path="/earloft/settings" />
                <data android:path="/earloft/podcasts" />
            </intent-filter>
            <!-- Credentials and the phone's answer when the download job is waiting for it (/earloft/phone-back, Review V1). -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/earloft/credentials" />
                <data android:path="/earloft/phone-back" />
            </intent-filter>
        </service>
    </application>

</manifest>
