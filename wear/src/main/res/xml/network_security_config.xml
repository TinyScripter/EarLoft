<?xml version="1.0" encoding="utf-8"?>
<!--
    As on the phone (app/.../network_security_config.xml): home servers often run over HTTP or with a self-signed
    certificate. The server dialog on the phone only allows HTTP after explicit confirmation; the watch takes over
    the servers set up there (Wear concept 6).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
