# Release application ID of the phone and the watch app (the debug builds add the suffix ".debug").
package_name("de.kleinabersmart.earloft")

# Service-account key of the Play Console. The file is not part of the repository; PLAY_JSON_KEY can point elsewhere.
# Relative paths start in the fastlane folder (__dir__ is not available in an Appfile).
json_key_file(ENV["PLAY_JSON_KEY"] || "play-service-account.json")
