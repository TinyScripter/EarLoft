# Uploads the Google Play store listing from fastlane/metadata/android: texts, icon, feature graphic and screenshots.
# Nothing goes live unless you pass publish:true; without it Google only validates the changes.
#
#   bundle exec fastlane validate_key             check that the service-account key reaches the Play Console
#   bundle exec fastlane listing                  texts + graphics + screenshots, validation only
#   bundle exec fastlane listing publish:true     really update the listing
#   bundle exec fastlane texts                    only the texts (title, short and full description)
#   bundle exec fastlane screenshots              only the screenshots, phone and watch
#   bundle exec fastlane submit_review            send the changes waiting in the Play Console for review
#
# Supply replaces the screenshots that are already in the listing. It does not upload app bundles or release notes.

opt_out_usage # no anonymous usage statistics to Google/fastlane
default_platform(:android)

# Absolute path of the service-account key. Lane code runs in the fastlane folder, but actions run in the project root,
# so the relative default from the Appfile would not be found by upload_to_play_store; it gets this path instead.
def play_json_key
  key = File.expand_path(ENV["PLAY_JSON_KEY"] || "play-service-account.json")
  UI.user_error!("No service-account key at #{key}. See tools/store-screenshots/README.md.") unless File.exist?(key)
  key
end

platform :android do
  desc "Check that the service-account key can reach the Play Console"
  lane :validate_key do
    key = play_json_key
    begin
      # The action validate_play_store_json_key only logs a failure, so the client is created here to make the lane fail.
      config = FastlaneCore::Configuration.create(
        Supply::Options.available_options, { json_key: key, package_name: CredentialsManager::AppfileConfig.try_fetch_value(:package_name) }
      )
      Supply::Client.make_from_config(params: config)
    rescue => e
      UI.user_error!("The key at #{key} did not work: #{e.message}")
    end
    UI.success("The service-account key can reach the Play Console.")
  end

  desc "Send the changes waiting in the Play Console for review (when the console's button does nothing)"
  lane :submit_review do
    # An edit starts from the console's draft, including changes not yet sent for review. Committing it unchanged and
    # without changesNotSentForReview sends them for review. Unlike supply there is no silent retry with that flag:
    # if Google refuses, the lane fails with Google's reason.
    package_name = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options, { json_key: play_json_key, package_name: package_name }
    )
    client = Supply::Client.make_from_config(params: Supply.config)
    client.begin_edit(package_name: package_name)
    api = client.client
    edit_id = client.current_edit.id
    begin
      api.validate_edit(package_name, edit_id)
      api.commit_edit(package_name, edit_id)
    rescue Google::Apis::Error => e
      reason = e.respond_to?(:body) && e.body ? e.body : e.message
      begin
        api.delete_edit(package_name, edit_id)
      rescue StandardError
        # The edit expires on its own.
      end
      UI.user_error!("Google refused to send the changes for review: #{reason}")
    end
    UI.success("Sent for review. Check the publishing overview in the Play Console: the changes should be in review.")
  end

  desc "Upload texts, graphics and screenshots of the store listing (add publish:true to really apply them)"
  lane :listing do |options|
    upload_listing(texts: true, graphics: true, screenshots: true, publish: options[:publish])
  end

  desc "Upload only the texts of the store listing"
  lane :texts do |options|
    upload_listing(texts: true, publish: options[:publish])
  end

  desc "Upload only the screenshots (phone and watch)"
  lane :screenshots do |options|
    upload_listing(screenshots: true, publish: options[:publish])
  end

  private_lane :upload_listing do |options|
    upload_to_play_store(
      # The listing belongs to the app, not to a track, but supply still looks up a release on the track
      # and fails if there is none. Production is empty as long as the app is only in testing.
      track: ENV["PLAY_TRACK"] || "internal",
      json_key: play_json_key,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: !options[:texts],
      skip_upload_images: !options[:graphics],
      skip_upload_screenshots: !options[:screenshots],
      validate_only: options[:publish].to_s != "true"
    )
  end
end
